{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Pigtail",
      "type": "process",
      "command": "cargo",
      "args": [
        "run",
        "-p",
        "pigtail"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$rustc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Build Pigtail (Debug)",
      "type": "process",
      "command": "cargo",
      "args": [
        "build",
        "-p",
        "pigtail"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$rustc"
      ],
      "group": "build"
    },
    {
      "label": "Build Pigtail (Release)",
      "type": "process",
      "command": "cargo",
      "args": [
        "build",
        "--release",
        "-p",
        "pigtail"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$rustc"
      ],
      "group": "build"
    },
    {
      "label": "Run All Tests",
      "type": "process",
      "command": "cargo",
      "args": [
        "test",
        "--workspace"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$rustc"
      ],
      "group": "test"
    },
    {
      "label": "Check Code with Clippy",
      "type": "process",
      "command": "cargo",
      "args": [
        "clippy",
        "--workspace",
        "--all-targets",
        "--",
        "-D",
        "warnings"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$rustc"
      ]
    }
  ]
}
